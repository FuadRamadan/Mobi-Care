# MobiCare — production environment variables
#
# Set these on the GoDaddy Node.js app. Everything marked SECRET goes in the
# encrypted secret store, never in a file and never in the repository.
#
# PORT is supplied by the platform — do not set it.
# Do not set any VITE_* variable here: those are build-time only and setting
# them at runtime does nothing.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# Serve both built frontends from the same process. Without this the app serves
# only the API and every page 404s.
SERVE_STATIC_DIR=./public

# ── Database ─────────────────────────────────────────────────────────────────
# SECRET. PostgreSQL, reached over WebSocket on 443 (Neon). See 2-DATABASE.md.
# The schema must already be current — the API exits at startup if it is behind.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ── Secrets ──────────────────────────────────────────────────────────────────
# SECRET, both. Generate each with:  openssl rand -hex 32
# They must be different values; the API refuses to start if they match.
#
# JWT_SECRET must be a NEW value — the previous one was committed to the
# repository and the API refuses to start with it. Rotating it only logs
# everyone out.
#
# SESSION_SECRET encrypts stored provider credentials and signs password-reset
# codes. Rotating it makes stored credentials permanently undecryptable and they
# must be re-entered in HQ. Set it once and leave it alone. See 4-SECRETS.md.
JWT_SECRET=
SESSION_SECRET=

# ── Origin ───────────────────────────────────────────────────────────────────
# The public HTTPS origin, no trailing slash. Required in production even though
# single-origin hosting means CORS is never exercised.
ALLOWED_ORIGINS=https://mobicare.sl

# Number of reverse proxies in front of the app. LOAD-BEARING for rate limiting:
# too low and every client shares one budget so a single attacker locks out
# everyone; too high and a client can spoof X-Forwarded-For and never be
# limited. 1 is right for a single reverse proxy. Confirm after deploying that
# the client address in the logs is the real caller, not the proxy.
TRUST_PROXY_HOPS=1

# ── Object storage ───────────────────────────────────────────────────────────
# The bucket must be PRIVATE: prescription images are medical records and the
# API enforces access on every read. See 3-OBJECT-STORAGE.md.
S3_ENDPOINT=https://s3.REGION.amazonaws.com
S3_REGION=REGION
S3_BUCKET=mobicare-media
S3_ACCESS_KEY_ID=                      # SECRET
S3_SECRET_ACCESS_KEY=                  # SECRET
# Optional — these are the defaults.
S3_PRIVATE_PREFIX=private
S3_PUBLIC_PREFIX=public
S3_FORCE_PATH_STYLE=true

# ── SMS ──────────────────────────────────────────────────────────────────────
SMS_TRANSPORT=orange
ORANGE_SMS_TIMEOUT_MS=10000

# ── Rate limits ──────────────────────────────────────────────────────────────
# Defaults shown. Raise only with a reason.
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_15_MIN=10

# ── First HQ account ─────────────────────────────────────────────────────────
# Optional, one time only. Creates the first HQ administrator so someone can
# sign in and onboard the pharmacies. REMOVE all three once it has run.
HQ_ADMIN_USERNAME=
HQ_ADMIN_PASSWORD=
HQ_ADMIN_NAME=
