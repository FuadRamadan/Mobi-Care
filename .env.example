# Runtime
NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# PostgreSQL (secret)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Which driver opens the connection: "postgres" (default, port 5432) or "neon"
# (the same protocol inside a WebSocket on 443, for hosts that allow only 80 and
# 443 outbound — GoDaddy among them). A *.neon.tech connection string selects
# "neon" on its own. Leave unset for local development.
DATABASE_DRIVER=

# Development only, ignored in production: point the Neon driver at a local
# WebSocket-to-TCP proxy so the whole app can run on the production driver
# against an ordinary PostgreSQL. See deploy/local/ws-proxy.mjs.
NEON_WS_PROXY=

# Authentication and encryption. Generate each with: openssl rand -hex 32
# They must be different values; the API refuses to start otherwise.
#
# JWT_SECRET signs access tokens and signed image URLs. Rotating it just logs
# everyone out.
#
# SESSION_SECRET encrypts stored provider credentials and signs password-reset
# codes. Rotating it makes stored provider credentials permanently
# undecryptable — they must be re-entered in HQ afterwards. See
# "Final Deployment files/4-SECRETS.md".
JWT_SECRET=
SESSION_SECRET=

# Comma-separated exact HTTPS frontend origins, without trailing slashes
ALLOWED_ORIGINS=https://mobicare.example.com,https://pharmacy.mobicare.example.com

# Frontend build configuration
VITE_API_URL=https://api.mobicare.example.com
VITE_PUBLIC_URL=https://mobicare.example.com
BASE_PATH=/

# Expo mobile production API host (hostname only, no scheme or path)
EXPO_PUBLIC_DOMAIN=api.mobicare.example.com

# Object storage — S3-compatible (AWS S3, Cloudflare R2, Backblaze B2).
# Used when the S3 adapter is selected; see "Final Deployment files/3-OBJECT-STORAGE.md".
# The bucket must be private: the API enforces access on every read.
S3_ENDPOINT=https://s3.REGION.amazonaws.com
S3_REGION=REGION
S3_BUCKET=mobicare-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: defaults are "private", "public", and path-style addressing.
S3_PRIVATE_PREFIX=private
S3_PUBLIC_PREFIX=public
S3_FORCE_PATH_STYLE=true

# Replit App Storage only. Not read once the S3 adapter is selected, but still
# the Replit adapter's configuration if you revert.
PRIVATE_OBJECT_DIR=/BUCKET/private
PUBLIC_OBJECT_SEARCH_PATHS=/BUCKET/public

# Number of reverse proxies in front of the API. Load-bearing for rate
# limiting: too low and every client shares one budget, too high and a client
# can spoof X-Forwarded-For to escape limits entirely. 1 for a single proxy.
TRUST_PROXY_HOPS=1

# Rate limits. Defaults shown; raise only with a reason.
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_15_MIN=10

# SMS behavior
SMS_TRANSPORT=orange
ORANGE_SMS_TIMEOUT_MS=10000

# Optional one-time HQ bootstrap; remove after successful bootstrap
HQ_ADMIN_USERNAME=
HQ_ADMIN_PASSWORD=
HQ_ADMIN_NAME=

# Development/test only
TEST_API_BASE_URL=
ORANGE_SMS_TEST_RECIPIENT=